{
    "name": "erp-firebase",
    "private": true,
    "version": "1.0.0",
    "description": "IR Assistant ERP Desktop Application",
    "author": "Antigravity",
    "type": "module",
    "main": "main.js",
    "scripts": {
        "dev": "concurrently \"vite\" \"node server.js\"",
        "dev:frontend": "vite",
        "dev:backend": "node server.js",
        "electron:dev": "concurrently \"vite\" \"electron .\"",
        "electron:build": "vite build && electron-builder",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@uiw/react-md-editor": "^4.1.1",
        "clsx": "^2.1.0",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "electron-updater": "^6.8.9",
        "express": "^5.2.1",
        "firebase": "^10.8.0",
        "jspdf": "^4.1.0",
        "jspdf-autotable": "^5.0.7",
        "lucide-react": "^0.344.0",
        "pg": "^8.21.0",
        "react": "^18.2.0",
        "react-datepicker": "^9.1.0",
        "react-dom": "^18.2.0",
        "react-grid-layout": "^2.2.3",
        "react-markdown": "^10.1.0",
        "react-quill": "^2.0.0",
        "react-resizable": "^4.0.1",
        "react-router-dom": "^6.22.1",
        "recharts": "^3.7.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^2.2.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/react": "^18.2.56",
        "@types/react-dom": "^18.2.19",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "electron": "^41.7.1",
        "electron-builder": "^26.15.2",
        "eslint": "^8.56.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "vite": "^5.1.4"
    },
    "build": {
        "appId": "com.irassistant.erp",
        "productName": "IR Assistant ERP",
        "publish": [
            {
                "provider": "github",
                "owner": "mightyZap25",
                "repo": "IRAssistance"
            }
        ],
        "files": [
            "dist/**/*",
            "main.js",
            "preload.js",
            "server.js",
            "app_tray_icon.png",
            "package.json"
        ],
        "directories": {
            "output": "dist-electron"
        },
        "win": {
            "target": [
                "nsis"
            ]
        }
    }
}
