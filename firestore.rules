rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isManagerOrAbove() {
      return isAuthenticated() && (
        getUserData().role == 'manager' || 
        getUserData().role == 'admin'
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // --- Collection Rules ---

    // Users: Anyone authenticated can read, only self or admin can write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Master Data (Parts, BOM, Vendors, Customers, Manufacturers, Inventory)
    // Read: Authenticated, Write: Manager or Admin (or Engineer for Parts/BOM)
    match /parts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('engineer');
    }
    match /bom/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('engineer');
    }
    match /vendors/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('sales') || hasRole('production');
    }
    match /customers/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('sales');
    }
    match /inventory/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('engineer') || hasRole('production');
    }
    match /transactions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('sales') || hasRole('engineer') || hasRole('production');
    }

    // Production (production_requests, receiving, ECN, purchasing)
    match /production_requests/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('sales') || hasRole('engineer') || hasRole('production');
    }
    match /purchasing/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('sales') || hasRole('production');
    }
    match /receiving/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('engineer') || hasRole('production');
    }
    match /ecn/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove(); // Only Manager/Admin can approve ECN
    }

    // Settlement (Sensitive)
    match /settlement/{docId} {
      allow read, write: if isManagerOrAbove();
    }

    // Personal Tasks
    match /personal_tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAbove() || hasRole('engineer');
    }

    // User Settings (Dashboard Layout, etc.)
    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
