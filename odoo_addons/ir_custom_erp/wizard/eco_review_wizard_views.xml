<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ir_eco_review_wizard_form" model="ir.ui.view">
            <field name="name">ir.eco.review.wizard.form</field>
            <field name="model">ir.eco.review.wizard</field>
            <field name="arch" type="xml">
                <form string="결재 처리">
                    <sheet>
                        <group>
                            <field name="action_type" invisible="1"/>
                            <field name="eco_id" invisible="1"/>
                            <field name="review_comment" placeholder="결재 의견이나 사유를 입력해주세요. (선택사항)"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="결재 완료" name="action_submit_review" type="object" class="oe_highlight"/>
                        <button string="취소" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
