<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ir_custom_erp.HrDashboard" owl="1">
        <div class="hr_dashboard_wrapper">
            <!-- Global Left Navigation Removed per user request -->
            <div class="hr_dashboard_container">
                <!-- Middle Sidebar -->
                <div class="hr_sidebar">
                <div class="sidebar_header">
                    <h4>내 근태 현황</h4>
                </div>
                <div class="sidebar_today">
                    <div class="today_date">오늘 <span t-esc="state.data.today_date"/></div>
                    <div class="greeting">
                        <strong t-esc="state.data.user_name"/>님, 안녕하세요.<br/>
                        <span class="status_text" t-esc="state.data.status_text"/>
                    </div>
                    <div class="work_type_badge">내근직</div>
                    
                    <div class="clock_times">
                        <div>출근 : <span t-esc="state.data.check_in_time"/></div>
                        <div>퇴근 : <span t-esc="state.data.check_out_time"/></div>
                    </div>
                    
                    <div class="progress_circle_wrapper">
                        <!-- CSS Donut Chart for work hours -->
                        <div class="progress_circle" t-attf-style="background: conic-gradient(#4318ff {{state.data.worked_hours_percent}}%, #eef2ff 0);">
                            <div class="inner_circle">
                                <div class="percent"><t t-esc="Math.round(state.data.worked_hours_percent)"/>%</div>
                                <div class="label">근무시간</div>
                                <div class="time"><t t-esc="state.data.worked_hours_week"/>h</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="clock_buttons" style="display: flex; flex-direction: column; gap: 10px;">
                        <button class="btn btn-primary clock_in_btn" t-on-click="_onClickClock">출근 / 퇴근</button>
                        <button class="btn btn-outline-primary schedule_change_btn" t-on-click="_onClickScheduleChange" style="border-radius: 14px; padding: 10px; font-weight: 600; width: 100%;">근무일정 변경 신청</button>
                    </div>
                </div>
                

            </div>
            
            <!-- Main Content -->
            <div class="hr_main">
                <!-- Top Metric Cards -->
                <div class="top_cards">
                    <div class="metric_card" t-on-click="_onClickAttendanceRequest">
                        <span class="card_title">근태 신청 (휴가/외근)</span>
                        <span class="card_value">
                            <t t-esc="(state.data.leave_total_days - state.data.leave_taken_days).toFixed(1)"/> / <t t-esc="state.data.leave_total_days"/>
                            <small class="text-muted ml-2">(잔여: <t t-esc="state.data.leave_remaining_hours"/>시간)</small>
                            <i class="fa fa-chevron-right ml-2"/>
                        </span>
                    </div>
                    <div class="metric_card" t-on-click="_onClickScheduleChange">
                        <span class="card_title">근무일정 변경 신청</span>
                        <span class="card_value"><i class="fa fa-chevron-right"/></span>
                    </div>
                    <div class="metric_card" t-on-click="_onClickPendingApprovals" style="cursor: pointer;">
                        <span class="card_title">내 결재 대기</span>
                        <span class="card_value">
                            <t t-esc="state.data.pending_approvals"/> 건
                            <i t-att-class="state.pendingPanel.open ? 'fa fa-chevron-up ml-1' : 'fa fa-chevron-down ml-1'"/>
                        </span>
                    </div>
                </div>

                <!-- ★ 결재 대기 모달 팝업 -->
                <div t-if="state.pendingPanel.open" class="pending_modal_backdrop" t-on-click="_onClickClosePendingPanel">
                    <div class="pending_modal_content" t-on-click.stop="">
                        <div class="pending_modal_header">
                            <h3><i class="fa fa-list-alt text-primary"/> 내 결재 대기 목록</h3>
                            <button class="btn_close" t-on-click="_onClickClosePendingPanel"><i class="fa fa-times"/></button>
                        </div>

                        <!-- 로딩 표시 -->
                        <div t-if="state.pendingPanel.loading" class="pending_loading">
                            <i class="fa fa-spinner fa-spin"/> 목록 로딩 중...
                        </div>

                        <div t-else="" class="pending_modal_body">
                            <!-- ① 내가 신청한 휴가 (결재 대기 중) -->
                            <div class="pending_section">
                                <div class="pending_section_title">
                                    <i class="fa fa-paper-plane text-primary"/> 내가 신청한 휴가
                                    <span class="badge badge-primary ml-1"><t t-esc="state.pendingPanel.my_requests.length"/>건</span>
                                </div>
                                <div t-if="state.pendingPanel.my_requests.length === 0" class="pending_empty">
                                    결재 대기 중인 신청이 없습니다.
                                </div>
                                <table t-else="" class="pending_table">
                                    <thead>
                                        <tr>
                                            <th>휴가 종류</th>
                                            <th>기간</th>
                                            <th>일수</th>
                                            <th>상태</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.pendingPanel.my_requests" t-as="req" t-key="req.id">
                                            <tr>
                                                <td><t t-esc="req.leave_type"/></td>
                                                <td><t t-esc="req.date_from"/> ~ <t t-esc="req.date_to"/></td>
                                                <td><t t-esc="req.number_of_days"/>일</td>
                                                <td>
                                                    <span t-attf-class="state_badge state_{{ req.state_raw }}">
                                                        <t t-esc="req.state"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this._onClickMyLeave(req.id)">
                                                        <i class="fa fa-eye"/> 보기
                                                    </button>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                            <!-- ② 내가 결재해야 할 휴가 -->
                            <div class="pending_section">
                                <div class="pending_section_title">
                                    <i class="fa fa-check-circle text-warning"/> 내가 결재해야 할 휴가
                                    <span class="badge badge-warning ml-1"><t t-esc="state.pendingPanel.to_approve.length"/>건</span>
                                </div>
                                <div t-if="state.pendingPanel.to_approve.length === 0" class="pending_empty">
                                    결재 요청된 항목이 없습니다.
                                </div>
                                <table t-else="" class="pending_table">
                                    <thead>
                                        <tr>
                                            <th>신청자</th>
                                            <th>부서</th>
                                            <th>휴가 종류</th>
                                            <th>기간</th>
                                            <th>일수</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.pendingPanel.to_approve" t-as="req" t-key="req.id">
                                            <tr>
                                                <td><strong><t t-esc="req.employee_name"/></strong></td>
                                                <td><t t-esc="req.department"/></td>
                                                <td><t t-esc="req.leave_type"/></td>
                                                <td><t t-esc="req.date_from"/> ~ <t t-esc="req.date_to"/></td>
                                                <td><t t-esc="req.number_of_days"/>일</td>
                                                <td>
                                                    <button class="btn btn-sm btn-primary" t-on-click="() => this._onClickApproveLeave(req.id)">
                                                    <i class="fa fa-check"/> 승인
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger ml-1" t-on-click="() => this._onClickRefuseLeave(req.id)">
                                                    <i class="fa fa-times"/> 반려
                                                </button>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Calendar Area (Placeholder for actual fullcalendar integration or custom grid) -->
                <div class="calendar_area">
                    <div class="calendar_header">
                        <h3 class="month_title"><t t-esc="state.calendar.currentMonthStr"/></h3>
                        <div class="arrows">
                            <button class="btn btn-sm" t-on-click="prevMonth"><i class="fa fa-chevron-left"/></button>
                            <button class="btn btn-sm" t-on-click="todayMonth">오늘</button>
                            <button class="btn btn-sm" t-on-click="nextMonth"><i class="fa fa-chevron-right"/></button>
                        </div>
                    </div>
                    <div class="calendar_legend">
                        <span class="leg_item"><i class="fa fa-umbrella text-primary"/> 휴가</span>
                        <span class="leg_item"><i class="fa fa-car text-info"/> 외근</span>
                        <span class="leg_item"><i class="fa fa-suitcase text-purple"/> 출장</span>
                        <span class="leg_item"><i class="fa fa-home text-danger"/> 재택근무</span>
                    </div>
                    <div class="calendar_grid">
                        <!-- Header -->
                        <div class="cal_head text-danger">일</div>
                        <div class="cal_head">월</div>
                        <div class="cal_head">화</div>
                        <div class="cal_head">수</div>
                        <div class="cal_head">목</div>
                        <div class="cal_head">금</div>
                        <div class="cal_head">토</div>
                        
                        <!-- Dynamic Rows -->
                        <t t-foreach="state.calendar.weeks" t-as="week" t-key="week[0].dateStr">
                            <t t-foreach="week" t-as="day" t-key="day.dateStr">
                                <div t-attf-class="cal_cell {{ !day.isCurrentMonth ? 'text-muted' : '' }} {{ day.isSunday ? 'text-danger' : '' }}">
                                    <div class="date_num"><t t-esc="day.dayNum"/></div>
                                    <div class="events_container">
                                        <t t-foreach="day.events" t-as="event" t-key="event.id">
                                            <div t-attf-class="event {{ event.color_class }}">
                                                <i t-attf-class="fa {{ event.icon }}"/> <t t-esc="event.title"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </t>
</templates>
