<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ir_custom_erp.HrDashboard" owl="1">
        <div class="hr_dashboard_wrapper">
            <!-- Global Left Navigation -->
            <div class="hr_nav_sidebar">
                <div class="nav_item active">내 근태 현황</div>
                <div class="nav_item">내 출퇴근 내역</div>
                
                <div class="nav_group_title">
                    <i class="fa fa-chevron-down"/> 근태 문서
                </div>
                <div class="nav_sub_items">
                    <div class="nav_item sub">내 신청 문서</div>
                    <div class="nav_item sub">내 결재 문서</div>
                    <div class="nav_item sub">내 참조 문서</div>
                </div>
            </div>

            <div class="hr_dashboard_container">
                <!-- Middle Sidebar -->
                <div class="hr_sidebar">
                <div class="sidebar_header">
                    <h4>내 근태 현황</h4>
                </div>
                <div class="sidebar_today">
                    <div class="today_date">오늘 <span t-esc="state.data.today_date"/></div>
                    <div class="greeting">
                        <strong t-esc="state.data.user_name"/>님, 안녕하세요.<br/>
                        <span class="status_text" t-esc="state.data.status_text"/>
                    </div>
                    <div class="work_type_badge">내근직</div>
                    
                    <div class="clock_times">
                        <div>출근 : <span t-esc="state.data.check_in_time"/></div>
                        <div>퇴근 : <span t-esc="state.data.check_out_time"/></div>
                    </div>
                    
                    <div class="progress_circle_wrapper">
                        <!-- CSS Donut Chart for work hours -->
                        <div class="progress_circle" t-attf-style="background: conic-gradient(#4d72fa {{state.data.worked_hours_percent}}%, #f0f2f5 0);">
                            <div class="inner_circle">
                                <div class="percent"><t t-esc="Math.round(state.data.worked_hours_percent)"/>%</div>
                                <div class="label">근무시간</div>
                                <div class="time"><t t-esc="state.data.worked_hours_week"/>h</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="clock_buttons">
                        <button class="btn btn-primary clock_in_btn" t-on-click="_onClickClock">출근 / 퇴근</button>
                    </div>
                </div>
                
                <!-- Weekly summary -->
                <div class="sidebar_weekly">
                    <div class="weekly_header">
                        <span>이번 주</span>
                        <div class="arrows">
                            <button class="btn btn-sm"><i class="fa fa-chevron-left"/></button>
                            <button class="btn btn-sm">오늘</button>
                            <button class="btn btn-sm"><i class="fa fa-chevron-right"/></button>
                        </div>
                    </div>
                    <div class="weekly_bar_container">
                        <div class="bar_labels">
                            <div class="label_item">주 근로시간<br/><b>40h 00m</b></div>
                            <div class="label_item">누적근로시간<br/><b t-esc="state.data.worked_hours_week + 'h'"/></div>
                            <div class="label_item">잔여근로시간<br/><b><t t-esc="(40 - state.data.worked_hours_week).toFixed(1)"/>h</b></div>
                        </div>
                        <div class="progress mt-2">
                            <div class="progress-bar bg-primary" role="progressbar" t-attf-style="width: {{state.data.worked_hours_percent}}%;"/>
                        </div>
                        <div class="bar_ticks">
                            <span>0</span>
                            <span>40</span>
                            <span>52</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="hr_main">
                <!-- Top Metric Cards -->
                <div class="top_cards">
                    <div class="metric_card" t-on-click="_onClickLeaveRequest">
                        <span class="card_title">휴가 신청</span>
                        <span class="card_value">
                            <t t-esc="(state.data.leave_total_days - state.data.leave_taken_days).toFixed(1)"/> / <t t-esc="state.data.leave_total_days"/>
                            <small class="text-muted ml-2">(잔여: <t t-esc="state.data.leave_remaining_hours"/>시간)</small>
                            <i class="fa fa-chevron-right ml-2"/>
                        </span>
                    </div>
                    <div class="metric_card" t-on-click="_onClickAttendanceRequest">
                        <span class="card_title">근태 신청 (출퇴근 변경/유연근무)</span>
                        <span class="card_value"><i class="fa fa-chevron-right"/></span>
                    </div>
                    <div class="metric_card">
                        <span class="card_title">결재 대기</span>
                        <span class="card_value"><t t-esc="state.data.pending_approvals"/> 건 <i class="fa fa-chevron-right"/></span>
                    </div>
                </div>
                
                <!-- Calendar Area (Placeholder for actual fullcalendar integration or custom grid) -->
                <div class="calendar_area">
                    <div class="calendar_header">
                        <div class="dropdowns">
                            <select class="form-select"><option>연구소</option></select>
                            <select class="form-select ml-2"><option>연차, 기타 휴가, 외근</option></select>
                        </div>
                        <h3 class="month_title"><t t-esc="state.calendar.currentMonthStr"/></h3>
                        <div class="arrows">
                            <button class="btn btn-sm" t-on-click="prevMonth"><i class="fa fa-chevron-left"/></button>
                            <button class="btn btn-sm" t-on-click="todayMonth">오늘</button>
                            <button class="btn btn-sm" t-on-click="nextMonth"><i class="fa fa-chevron-right"/></button>
                        </div>
                    </div>
                    <div class="calendar_legend">
                        <span class="leg_item"><i class="fa fa-umbrella text-primary"/> 휴가</span>
                        <span class="leg_item"><i class="fa fa-car text-info"/> 외근</span>
                        <span class="leg_item"><i class="fa fa-suitcase text-purple"/> 출장</span>
                        <span class="leg_item"><i class="fa fa-home text-danger"/> 재택근무</span>
                    </div>
                    <div class="calendar_grid">
                        <!-- Header -->
                        <div class="cal_head text-danger">일</div>
                        <div class="cal_head">월</div>
                        <div class="cal_head">화</div>
                        <div class="cal_head">수</div>
                        <div class="cal_head">목</div>
                        <div class="cal_head">금</div>
                        <div class="cal_head">토</div>
                        
                        <!-- Dynamic Rows -->
                        <t t-foreach="state.calendar.weeks" t-as="week" t-key="week[0].dateStr">
                            <t t-foreach="week" t-as="day" t-key="day.dateStr">
                                <div t-attf-class="cal_cell {{ !day.isCurrentMonth ? 'text-muted' : '' }} {{ day.isSunday ? 'text-danger' : '' }}">
                                    <div class="date_num"><t t-esc="day.dayNum"/></div>
                                    <div class="events_container">
                                        <t t-foreach="day.events" t-as="event" t-key="event.id">
                                            <div t-attf-class="event {{ event.color_class }}">
                                                <i t-attf-class="fa {{ event.icon }}"/> <t t-esc="event.title"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </t>
</templates>
