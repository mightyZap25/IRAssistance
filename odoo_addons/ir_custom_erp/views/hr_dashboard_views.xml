<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client Action for the Owl Dashboard -->
        <record id="action_hr_dashboard" model="ir.actions.client">
            <field name="name">내 근태 현황 (대시보드)</field>
            <field name="tag">ir_custom_erp.hr_dashboard_action</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_hr_dashboard"
                  name="근태/휴가 대시보드"
                  action="action_hr_dashboard"
                  web_icon="hr_attendance,static/description/icon.png"/>

        <!-- Make Attendance and Time Off submenus of this dashboard to appear as tabs -->
        <menuitem id="hr_attendance.menu_hr_attendance_root" parent="ir_custom_erp.menu_hr_dashboard" sequence="10"/>
        <menuitem id="hr_holidays.menu_hr_holidays_root" parent="ir_custom_erp.menu_hr_dashboard" sequence="20"/>
    </data>
</odoo>
