<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hr_schedule_change_form" model="ir.ui.view">
        <field name="name">hr.schedule.change.form</field>
        <field name="model">hr.schedule.change</field>
        <field name="arch" type="xml">
            <form string="Working Schedule Change">
                <header>
                    <button name="action_confirm" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'confirm'" groups="hr.group_hr_manager"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'confirm'" groups="hr.group_hr_manager"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('approved', 'rejected')" groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="current_calendar_id"/>
                            <field name="requested_calendar_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason">
                            <field name="reason" placeholder="Please provide a reason for this schedule change..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Modal Form View for Employee Submission -->
    <record id="view_hr_schedule_change_form_modal" model="ir.ui.view">
        <field name="name">hr.schedule.change.form.modal</field>
        <field name="model">hr.schedule.change</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Working Schedule Change">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="current_calendar_id"/>
                            <field name="requested_calendar_id" required="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason">
                            <field name="reason" placeholder="Please provide a reason for this schedule change..." required="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hr_schedule_change_tree" model="ir.ui.view">
        <field name="name">hr.schedule.change.list</field>
        <field name="model">hr.schedule.change</field>
        <field name="arch" type="xml">
            <list string="Schedule Changes">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="current_calendar_id" optional="show"/>
                <field name="requested_calendar_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'confirm'"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_schedule_change" model="ir.actions.act_window">
        <field name="name">근무일정 변경 신청</field>
        <field name="res_model">hr.schedule.change</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new schedule change request
            </p>
        </field>
    </record>
    
    <!-- Action for Modal (Employees) -->
    <record id="action_hr_schedule_change_modal" model="ir.actions.act_window">
        <field name="name">근무일정 변경 신청</field>
        <field name="res_model">hr.schedule.change</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_schedule_change_form_modal"/>
        <field name="target">new</field>
    </record>

    <!-- Menu Item for HR Managers -->
    <menuitem id="menu_hr_schedule_change"
              name="근무일정 변경 결재"
              parent="hr.menu_hr_root"
              action="action_hr_schedule_change"
              sequence="90"
              groups="hr.group_hr_manager"/>

    <!-- Wizard for My Pending Approvals -->
    <record id="view_hr_pending_approvals_wizard_form" model="ir.ui.view">
        <field name="name">hr.pending.approvals.wizard.form</field>
        <field name="model">hr.pending.approvals.wizard</field>
        <field name="arch" type="xml">
            <form string="내 결재 대기 현황">
                <sheet>
                    <notebook>
                        <page string="휴가 신청 내역">
                            <field name="leave_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="holiday_status_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="state" widget="badge" decoration-info="state == 'confirm'"/>
                                </list>
                            </field>
                        </page>
                        <page string="근무일정 신청 내역">
                            <field name="schedule_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="requested_calendar_id"/>
                                    <field name="state" widget="badge" decoration-info="state == 'confirm'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_pending_approvals_wizard" model="ir.actions.act_window">
        <field name="name">내 결재 대기 현황</field>
        <field name="res_model">hr.pending.approvals.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
