<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Actions for Google Drive Sync -->
    <record id="action_sync_all_existing_data" model="ir.actions.server">
        <field name="name">구글 드라이브 전체 강제 동기화 (기존 데이터)</field>
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_sync_all_existing_data()
        </field>
    </record>

    <record id="action_sync_schema" model="ir.actions.server">
        <field name="name">DB 스키마(구조) 구글 드라이브로 백업</field>
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_sync_schema()
        </field>
    </record>

    <!-- Settings 앱의 상단 메뉴바에 직접 버튼 메뉴 추가 -->
    <menuitem id="menu_google_drive_sync_main" 
              name="Google Drive 백업" 
              parent="base.menu_administration" 
              sequence="100"/>
              
    <menuitem id="menu_sync_all_data_btn" 
              name="전체 데이터 백업 실행" 
              parent="menu_google_drive_sync_main" 
              action="action_sync_all_existing_data" 
              sequence="10"/>
              
    <menuitem id="menu_sync_schema_btn" 
              name="스키마 내보내기" 
              parent="menu_google_drive_sync_main" 
              action="action_sync_schema" 
              sequence="20"/>
</odoo>
