<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ir_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ir.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Approval" string="전자결재" name="ir_approval">
                    <block title="회사 직인 설정" name="company_seal_block">
                        <setting id="company_seal_setting" string="회사 직인(Company Seal)" help="전자결재 인쇄물(재직증명서 등)에 삽입될 직인 이미지를 등록합니다.">
                            <field name="company_seal" widget="image" class="w-25"/>
                        </setting>
                    </block>
                    
                    <block title="인쇄 양식 설정" name="print_layout_block">
                        <setting string="기본 여백 (mm)" help="인쇄 시 상하좌우 여백을 설정합니다 (기본 10).">
                            <field name="ir_approval_print_margin"/>
                        </setting>
                        <setting string="문서 제목 폰트 크기 (px)" help="인쇄 양식 중앙의 제목 크기를 설정합니다 (기본 34).">
                            <field name="ir_approval_title_font_size"/>
                        </setting>
                        <setting string="문서 제목 정렬 위치" help="제목의 좌우 정렬을 설정합니다 (기본 가운데).">
                            <field name="ir_approval_title_align"/>
                        </setting>
                        <setting string="문서 제목 상단 여백 (px)" help="제목 위쪽의 빈 공간을 설정합니다 (기본 0).">
                            <field name="ir_approval_title_margin_top"/>
                        </setting>
                        <setting string="문서 제목 자간 (px)" help="제목 글자 사이의 간격을 설정합니다 (기본 0).">
                            <field name="ir_approval_title_letter_spacing"/>
                        </setting>
                        <setting string="결재칸 가로 너비 (px)" help="우측 결재 도장칸의 전체 가로 길이를 설정합니다 (기본 250).">
                            <field name="ir_approval_approval_box_width"/>
                        </setting>
                        <setting string="결재칸 정렬 위치" help="결재칸의 좌우 정렬을 설정합니다 (기본 오른쪽).">
                            <field name="ir_approval_approval_box_align"/>
                        </setting>
                        <setting string="결재칸 상단 여백 (px)" help="결재칸 위쪽의 빈 공간을 설정합니다 (기본 0).">
                            <field name="ir_approval_approval_box_margin_top"/>
                        </setting>
                        <setting string="결재칸 우측 여백 (px)" help="결재칸 우측의 빈 공간을 설정합니다 (기본 0).">
                            <field name="ir_approval_approval_box_margin_right"/>
                        </setting>
                        <setting string="본문 테이블 상단 여백 (px)" help="문서 본문 테이블 위의 빈 공간을 설정합니다 (기본 20).">
                            <field name="ir_approval_content_margin_top"/>
                        </setting>
                        <setting string="본문 상세내용칸 최소 높이 (px)" help="상세내용이 적어도 기본적으로 확보할 최소 높이를 설정합니다 (기본 200).">
                            <field name="ir_approval_content_min_height"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ir_approval_config_settings" model="ir.actions.act_window">
        <field name="name">설정</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'ir_approval'}</field>
    </record>

    <menuitem id="menu_ir_approval_config" name="설정" parent="ir_approval.menu_ir_approval_root" action="action_ir_approval_config_settings" sequence="100" groups="base.group_erp_manager"/>
</odoo>

