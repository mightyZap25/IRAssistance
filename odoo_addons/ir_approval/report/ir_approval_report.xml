<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 인쇄 액션(버튼) 정의 -->
    <record id="action_report_ir_approval" model="ir.actions.report">
        <field name="name">전자결재 문서 인쇄</field>
        <field name="model">ir_approval.request</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ir_approval.report_ir_approval_document</field>
        <field name="report_file">ir_approval.report_ir_approval_document</field>
        <field name="print_report_name">'결재문서_%s' % (object.name or '문서')</field>
        <field name="binding_model_id" ref="model_ir_approval_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 인쇄 문서 템플릿(레이아웃) -->
    <template id="report_ir_approval_document">
        <t t-call="web.html_container">
            <style>
                @media print {
                    @page { margin: 10mm; } /* 크롬 인쇄 시 기본 여백 축소 */
                    body, .article, .page { padding: 0 !important; margin: 0 !important; }
                    .d-print-none { display: none !important; }
                }
                .article { padding: 0 !important; } /* 웹 미리보기 시 여백 축소 */
            </style>
            <t t-foreach="docs" t-as="doc">
                <div class="article" t-att-data-oe-model="doc and doc._name" t-att-data-oe-id="doc and doc.id">
                    
                    <!-- HTML 미리보기 시 상단에 플로팅 인쇄 버튼 추가 -->
                    <div class="d-print-none" style="position: fixed; top: 20px; right: 20px; z-index: 1000;">
                        <button onclick="window.print()" class="btn btn-primary" style="padding: 10px 20px; font-size: 16px; font-weight: bold; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                            🖨️ 인쇄하기
                        </button>
                    </div>

                    <div class="page">
                        <t t-if="doc.doc_type == 'EMPLOYMENT_CERT'">
                            <div style="width: 100%; max-width: 800px; margin: 0 auto; font-family: 'Malgun Gothic', sans-serif;">
                                <!-- 로고 -->
                                <div style="text-align: center; margin-top: 40px; margin-bottom: 30px;">
                                    <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 80px;" alt="Logo"/>
                                </div>
                                
                                <!-- 타이틀 -->
                                <h1 style="text-align: center; font-size: 36px; letter-spacing: 15px; margin-bottom: 50px;"><strong>재직증명서</strong></h1>
                                
                                <!-- 테이블 영역 -->
                                <table style="width: 100%; border-collapse: collapse; border-top: 2px solid #333; border-bottom: 2px solid #ccc; font-size: 13px;">
                                    <tbody>
                                        <!-- 인적사항 -->
                                        <tr>
                                            <th rowspan="2" style="width: 15%; background-color: #f1f0f6; border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; text-align: center; padding: 15px;">인적사항</th>
                                            <th style="width: 15%; background-color: #fafafa; border-bottom: 1px solid #e0e0e0; text-align: center; padding: 10px;">성명</th>
                                            <td style="width: 35%; border-bottom: 1px solid #e0e0e0; padding: 10px;"><span t-field="doc.emp_cert_name"/></td>
                                            <th style="width: 15%; background-color: #fafafa; border-bottom: 1px solid #e0e0e0; text-align: center; padding: 10px;">생년월일</th>
                                            <td style="width: 20%; border-bottom: 1px solid #e0e0e0; padding: 10px;">
                                                <span t-if="doc.emp_cert_birth_date" t-esc="doc.emp_cert_birth_date.strftime('%Y년 %m월 %d일')"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #fafafa; border-bottom: 1px solid #e0e0e0; text-align: center; padding: 10px;">주소</th>
                                            <td colspan="3" style="border-bottom: 1px solid #e0e0e0; padding: 10px;"><span t-field="doc.emp_cert_address"/></td>
                                        </tr>
                                        <!-- 재직사항 -->
                                        <tr>
                                            <th rowspan="2" style="background-color: #f1f0f6; border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; text-align: center; padding: 15px;">재직사항</th>
                                            <th style="background-color: #fafafa; border-bottom: 1px solid #e0e0e0; text-align: center; padding: 10px;">소속</th>
                                            <td style="border-bottom: 1px solid #e0e0e0; padding: 10px;"><span t-field="doc.emp_cert_department"/></td>
                                            <th style="background-color: #fafafa; border-bottom: 1px solid #e0e0e0; text-align: center; padding: 10px;">직위</th>
                                            <td style="border-bottom: 1px solid #e0e0e0; padding: 10px;"><span t-field="doc.emp_cert_job_title"/></td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #fafafa; border-bottom: 1px solid #e0e0e0; text-align: center; padding: 10px;">재직기간</th>
                                            <td colspan="3" style="border-bottom: 1px solid #e0e0e0; padding: 10px;">
                                                <span t-if="doc.emp_cert_start_date" t-esc="doc.emp_cert_start_date.strftime('%Y년 %m월 %d일')"/> ~ 
                                                <span t-if="doc.emp_cert_end_date" t-esc="doc.emp_cert_end_date.strftime('%Y년 %m월 %d일')"/>
                                            </td>
                                        </tr>
                                        <!-- 용도 -->
                                        <tr>
                                            <th style="background-color: #f1f0f6; border-bottom: 2px solid #ccc; border-right: 1px solid #e0e0e0; text-align: center; padding: 15px;">용도</th>
                                            <td colspan="4" style="border-bottom: 2px solid #ccc; padding: 10px;"><span t-field="doc.emp_cert_purpose"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                
                                <!-- 발급 담당자 -->
                                <table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #ccc; margin-top: 15px; font-size: 13px;">
                                    <tbody>
                                        <tr>
                                            <th rowspan="2" style="width: 15%; background-color: #fafafa; border-right: 1px solid #e0e0e0; text-align: center; padding: 15px;">발급<br/>담당자</th>
                                            <th style="width: 15%; text-align: center; padding: 10px;">소속</th>
                                            <td style="width: 35%; padding: 10px;"><span t-field="doc.emp_cert_issuer_dept"/></td>
                                            <th style="width: 15%; text-align: center; padding: 10px;">직위</th>
                                            <td style="width: 20%; padding: 10px;"><span t-field="doc.emp_cert_issuer_title"/></td>
                                        </tr>
                                        <tr>
                                            <th style="text-align: center; padding: 10px;">성명</th>
                                            <td style="padding: 10px;"><span t-field="doc.emp_cert_issuer_name"/></td>
                                            <th style="text-align: center; padding: 10px;">전화번호</th>
                                            <td style="padding: 10px;"><span t-field="doc.emp_cert_issuer_phone"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                
                                <!-- 증명 문구 -->
                                <div style="margin-top: 60px; text-align: center; font-size: 15px;">
                                    상기인은 <span t-if="doc.emp_cert_start_date" t-esc="doc.emp_cert_start_date.strftime('%Y년 %m월 %d일')"/> 당사에 입사하여 현재까지 재직 중에 있음을 증명합니다.
                                </div>
                                
                                <!-- 작성일자 -->
                                <div style="margin-top: 60px; text-align: center; font-size: 15px;">
                                    <span t-esc="context_today().strftime('%Y년 %m월 %d일')"/>
                                </div>
                                
                                <!-- 서명란 -->
                                <div style="margin-top: 60px; text-align: right; position: relative;">
                                    <span style="font-size: 16px; margin-right: 20px; font-weight: bold;">대표이사</span>
                                    <span style="font-size: 16px; margin-right: 60px;">(인)</span>
                                    <!-- 직인 이미지 -->
                                    <t t-if="doc.company_id.company_seal">
                                        <img t-att-src="image_data_uri(doc.company_id.company_seal)" style="position: absolute; right: 20px; top: -15px; width: 60px; height: 60px;" alt="Seal"/>
                                    </t>
                                </div>
                                
                                <!-- 회사명 -->
                                <div style="margin-top: 50px; text-align: center; font-size: 24px; font-weight: bold; letter-spacing: 2px;">
                                    <span t-field="doc.company_id.name"/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <!-- 기존 양식 -->

                        <!-- 상단 1: 우측 결재도장칸 (wkhtmltopdf 호환을 위해 float 대신 table 구조 사용) -->
                        <table style="width: 100%; border: none; margin-bottom: 20px;">
                            <tr>
                                <td style="border: none;"></td> <!-- 빈 공간으로 우측으로 밀어내기 -->
                                <td style="width: 260px; border: none; text-align: right;">
                                    <table class="text-center" style="width: 250px; border-collapse: collapse; border: 2px solid black; font-size: 12px; display: inline-table;">
                                        <tbody>
                                            <tr>
                                                <td rowspan="3" style="vertical-align: middle; background-color: #f8f9fa; font-weight: bold; width: 15%; padding: 4px; border: 1px solid black;">결재</td>
                                                <td style="background-color: #f8f9fa; font-weight: bold; padding: 4px; border: 1px solid black;">기안자</td>
                                                <td style="background-color: #f8f9fa; font-weight: bold; padding: 4px; border: 1px solid black;">결재권자 1</td>
                                                <td style="background-color: #f8f9fa; font-weight: bold; padding: 4px; border: 1px solid black;">최종 결재</td>
                                            </tr>
                                            <tr>
                                                <td style="height: 50px; vertical-align: middle; padding: 0; border: 1px solid black;">
                                                    <span t-field="doc.requestor_id"/>
                                                </td>
                                                <td style="height: 50px; vertical-align: middle; padding: 0; border: 1px solid black;">
                                                    <t t-if="doc.status in ['PENDING', 'APPROVED', 'REJECTED']">검토</t>
                                                </td>
                                                <td style="height: 50px; vertical-align: middle; padding: 0; border: 1px solid black;">
                                                    <t t-if="doc.status == 'APPROVED'">✅ 승인</t>
                                                    <t t-if="doc.status == 'REJECTED'">❌ 반려</t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 9px; padding: 2px; border: 1px solid black;"><span t-field="doc.create_date" t-options='{"widget": "date"}'/></td>
                                                <td style="font-size: 9px; padding: 2px; border: 1px solid black;"></td>
                                                <td style="font-size: 9px; padding: 2px; border: 1px solid black;"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- 상단 2: 중앙 문서 종류(타이틀) -->
                        <div style="text-align: center; margin-bottom: 30px; width: 100%;">
                            <t t-if="doc.doc_type == 'EXPENSE_RESOLUTION'">
                                <h1 style="margin: 0; font-size: 34px; white-space: nowrap;"><strong>지출결의서</strong></h1>
                            </t>
                            <t t-else="">
                                <h1 style="margin: 0; font-size: 34px; white-space: nowrap;"><strong><span t-field="doc.doc_type"/></strong></h1>
                            </t>
                        </div>

                        <hr style="border-top: 2px solid #333; margin-bottom: 20px;"/>

                        <!-- 상세 내역 테이블 -->
                        <table class="table table-bordered mt-4" style="border: 2px solid black; width: 100%; font-size: 14px; text-align: left;">
                            <tbody>
                                <tr>
                                    <th style="width: 20%; background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">문서 제목</th>
                                    <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><strong><span t-field="doc.name"/></strong></td>
                                </tr>
                                <t t-if="doc.doc_type != 'EXPENSE_RESOLUTION'">
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">문서 종류</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.doc_type"/></td>
                                    </tr>
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">현재 상태</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.status"/></td>
                                    </tr>
                                </t>
                                
                                <tr>
                                    <th style="width: 20%; background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">기안 부서</th>
                                    <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.department_id"/></td>
                                </tr>
                                
                                <t t-if="doc.doc_type == 'EXPENSE_RESOLUTION'">
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">문서번호</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.expense_doc_no"/></td>
                                    </tr>
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">결재조건</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.expense_approval_condition"/></td>
                                    </tr>
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">영수/청구 구분</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.expense_receipt_type"/></td>
                                    </tr>
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">사용자 / 직급</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.expense_user"/> / <span t-field="doc.expense_job_title"/></td>
                                    </tr>
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">사용금액</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.expense_amount"/></td>
                                    </tr>
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;">거래처명</th>
                                        <td style="vertical-align: middle; padding: 12px; border: 1px solid #dee2e6;"><span t-field="doc.expense_vendor"/></td>
                                    </tr>
                                </t>
                                
                                <t t-if="doc.description">
                                    <tr>
                                        <th style="background-color: #f8f9fa; vertical-align: top; padding: 12px; border: 1px solid #dee2e6; padding-top: 20px;">상세 내용</th>
                                        <td style="vertical-align: top; padding: 15px; border: 1px solid #dee2e6; height: 350px;">
                                            <span t-field="doc.description" t-options="{'widget': 'html'}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        </t>
                    </div>
                    
                    <!-- 브라우저 인쇄 팝업 자동 실행 -->
                    <script type="text/javascript">
                        window.onload = function() {
                            setTimeout(function() {
                                window.print();
                            }, 500);
                        };
                    </script>
                </div>
            </t>
        </t>
    </template>
</odoo>
